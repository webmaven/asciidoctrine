# ---------------------------------------------------------------------------
# Normalize every text file to LF in the repository index.
#
# This is required for cross-platform correctness, not cosmetic tidiness:
# asciidoctrine guarantees 100% character-for-character round-trip fidelity
# (see "Unified LF Normalization" in AGENTS.md). The parser detects the
# document's original line ending and reproduces it on serialize, so a
# contributor whose working tree holds CRLF (the Windows default when
# `core.autocrlf=true`) sees different parse results than a contributor on
# Linux/macOS. Forcing LF keeps the index -- and therefore the parser's input
# -- identical on every platform.
#
# `eol=lf` intentionally overrides a global `core.autocrlf=true`.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# --- Formats where a CRLF would change program semantics ---
*.py    text eol=lf
*.lark  text eol=lf
*.adoc  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.mjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf
*.pyi   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# --- Binary artifacts: never normalize ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.whl   binary
*.gz    binary
*.bz2   binary
*.pdf   binary
