
start: document

document: document_header_with_body | body_only

document_header_with_body: document_header (blank_line block*)?
body_only: block*

document_header: document_title (attribute_entry | author_rev_line)*
author_rev_line: WORD (inline_element)* _NEWLINE
document_title: DOC_TITLE_LEAD text_content _NEWLINE

block: section | blank_line | attribute_entry | ulist | olist | literal_block | admonition | sidebar | example_block | paragraph

blank_line: _NEWLINE+

// Sections and Titles
section: section_title block*
section_title: SECTION_TITLE_LEAD text_content _NEWLINE

// Paragraphs
paragraph: (text_content _NEWLINE)+

// Lists
ulist: ulist_item+
olist: olist_item+

ulist_item: ULIST_MARKER text_content _NEWLINE
olist_item: OLIST_MARKER text_content _NEWLINE

// Attributes
attribute_entry.2: COLON ATTR_NAME COLON [WHITESPACE] [text_content] _NEWLINE

// Attribute List (e.g., [source,python])
attribute_list: "[" attribute_content "]" _NEWLINE
attribute_content: /[^\]]+/

// Literal Blocks
// Can optionally be preceded by an attribute list
literal_block: attribute_list? LITERAL_BLOCK_DELIM _NEWLINE LITERAL_BLOCK_CONTENT _NEWLINE LITERAL_BLOCK_DELIM

// Basic content (no containers)
basic_block: literal_block | ulist | olist | paragraph | blank_line

// Admonitions allow sidebars but not (implicitly) other admonitions to avoid ambiguity without delimiter size checks
admonition: ADMONITION_START _NEWLINE ADMONITION_DELIM _NEWLINE admonition_content ADMONITION_DELIM _NEWLINE?
admonition_content: (sidebar | example_block | basic_block)*

// Example Blocks
example_block: ADMONITION_DELIM _NEWLINE example_content ADMONITION_DELIM _NEWLINE?
example_content: (admonition | sidebar | basic_block)*

// Sidebars allow admonitions but not other sidebars
sidebar: SIDEBAR_DELIM _NEWLINE sidebar_content SIDEBAR_DELIM _NEWLINE?
sidebar_content: (admonition | example_block | basic_block)*

// --- Inline Elements ---
// Using a recursive definition. Requires the Earley parser.
text_content: inline_element+

attribute_reference: LBRACE ATTR_NAME RBRACE
?inline_element: bold | italic | monospace | attribute_reference | WORD | WHITESPACE | COLON

bold: "*" text_content "*"
italic: "_" text_content "_"
monospace: "`" text_content "`"


// --- Terminals ---

// Block Terminals
DOC_TITLE_LEAD: /= [ \t]*/
SECTION_TITLE_LEAD: /==+ [ \t]*/
ULIST_MARKER: /(\*+|[-])[ \t]+/
OLIST_MARKER: /([0-9]+\.|[\.]+)[ \t]+/
LITERAL_BLOCK_DELIM.2: /----/
ADMONITION_START: /\[ *(NOTE|TIP|IMPORTANT|WARNING|CAUTION) *\]/
ADMONITION_DELIM: /====/
SIDEBAR_DELIM: /\*\*\*\*/

// Non-greedy content matching for literal blocks.
LITERAL_BLOCK_CONTENT: /(.+?)(?=\n----)/s

_NEWLINE: /(\r\n|\n|\r)/
WHITESPACE: /[ \t]+/
ATTR_NAME: /[a-zA-Z0-9_\-]+/
WORD: /[^ \t\n*_`=\[\]{}:]+/  // Word characters (not whitespace or markup)
LBRACE: "{"
RBRACE: "}"
COLON: ":"

// %ignore WHITESPACE
