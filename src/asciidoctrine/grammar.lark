
start: document

document: document_header_with_body | body_only

document_header_with_body: (comment | blank_line)* document_header (blank_line block*)?
body_only: block*

document_header: document_title (attribute_entry | author_rev_line)*
author_rev_line: WORD (WORD | WHITESPACE | COLON | AUTHOR_SPECIAL_CHARS)* _NEWLINE
document_title: DOC_TITLE_LEAD WHITESPACE text_content _NEWLINE

AUTHOR_SPECIAL_CHARS: /[<>;,.@\-_]/

block: attributed_block | blank_line | attribute_entry | comment | block_macro | thematic_break | page_break

blank_line: _NEWLINE+

comment: "//" [COMMENT_CONTENT] _NEWLINE
COMMENT_CONTENT: /[^\n]+/

attributed_block: (block_metadata)* (section | ulist | olist | dlist | colist | table | listing_block | literal_block | passthrough_block | outer_listing_block | outer_literal_block | outer_passthrough_block | outer_comment_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | indented_literal | paragraph)

attributed_simple_block: (block_metadata)* (ulist | olist | dlist | colist | listing_block | literal_block | passthrough_block | outer_listing_block | outer_literal_block | outer_passthrough_block | outer_comment_block | shorthand_admonition | indented_literal | paragraph)

block_metadata: block_title | attribute_list | anchor
block_title: "." text_content _NEWLINE

// Sections and Titles
section: section_title
section_title: SECTION_TITLE_LEAD WHITESPACE text_content _NEWLINE

// Paragraphs
paragraph: (text_content _NEWLINE)+

indented_literal: INDENTED_LITERAL_LEAD text_content _NEWLINE
INDENTED_LITERAL_LEAD: /[ \t]+/

shorthand_admonition: ADMONITION_TYPE COLON [WHITESPACE] text_content _NEWLINE
ADMONITION_TYPE: "NOTE" | "TIP" | "IMPORTANT" | "WARNING" | "CAUTION"

// Lists
ulist: ulist_item+
olist: olist_item+
?dlist: dlist_5 | dlist_4 | dlist_3 | dlist_2
colist: colist_item+

ulist_item.5: ULIST_MARKER [CHECKBOX] text_content _NEWLINE
olist_item.5: OLIST_MARKER text_content _NEWLINE

colist_item.5: "<" NUMBER ">" [WHITESPACE] text_content _NEWLINE

?dlist_nested_2: dlist_5 | dlist_4 | dlist_3
?dlist_nested_3: dlist_5 | dlist_4 | dlist_2
?dlist_nested_4: dlist_5 | dlist_3 | dlist_2
?dlist_nested_5: dlist_4 | dlist_3 | dlist_2

dlist_2: dlist_item_2+ -> dlist
dlist_item_2.-5: dlist_term_2+ dlist_description_2? -> dlist_item
dlist_term_2.12: text_content DLIST_MARKER_2 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_2.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_2 | colist | table | listing_block | literal_block | passthrough_block | outer_listing_block | outer_literal_block | outer_passthrough_block | outer_comment_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

dlist_3: dlist_item_3+ -> dlist
dlist_item_3.-5: dlist_term_3+ dlist_description_3? -> dlist_item
dlist_term_3.12: text_content DLIST_MARKER_3 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_3.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_3 | colist | table | listing_block | literal_block | passthrough_block | outer_listing_block | outer_literal_block | outer_passthrough_block | outer_comment_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

dlist_4: dlist_item_4+ -> dlist
dlist_item_4.-5: dlist_term_4+ dlist_description_4? -> dlist_item
dlist_term_4.12: text_content DLIST_MARKER_4 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_4.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_4 | colist | table | listing_block | literal_block | passthrough_block | outer_listing_block | outer_literal_block | outer_passthrough_block | outer_comment_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

dlist_5: dlist_item_5+ -> dlist
dlist_item_5.-5: dlist_term_5+ dlist_description_5? -> dlist_item
dlist_term_5.12: text_content DLIST_MARKER_5 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_5.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_5 | colist | table | listing_block | literal_block | passthrough_block | outer_listing_block | outer_literal_block | outer_passthrough_block | outer_comment_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

CHECKBOX: /\[[ x*X]\][ \t]+/

// Attributes
attribute_entry.10: COLON ATTR_NAME [BANG] COLON [WHITESPACE] [text_content] _NEWLINE
                 | COLON BANG ATTR_NAME COLON [WHITESPACE] _NEWLINE

BANG: "!"

// Attribute List (e.g., [source,python])
attribute_list.1: "[" [ATTR_LIST_CONTENT] "]" _NEWLINE
ATTR_LIST_CONTENT: /[^\]]+/

inline_attribute_list: "[" [ATTR_LIST_CONTENT] "]"

anchor.15: "[[" WORD "]]" _NEWLINE

// Tables
table.50: TABLE_DELIM _NEWLINE (table_cell | _NEWLINE)* TABLE_DELIM _NEWLINE?
table_cell: [table_cell_spec] TABLE_CELL

table_cell_spec: (span_spec | multiplier_spec)? (align_spec)? [STYLE_SPEC]

?span_spec: [NUMBER] "." NUMBER "+" -> span_both
          | NUMBER "+"             -> span_cols

?multiplier_spec: NUMBER "*" -> multiplier

?align_spec: HORIZ_ALIGN [VERT_ALIGN] -> align_both
           | VERT_ALIGN             -> align_vert

TABLE_DELIM.30: "|==="


HORIZ_ALIGN: "<" | ">" | "^"
VERT_ALIGN: "." ("<" | ">" | "^")
STYLE_SPEC: /[adehlms]/


// Listing and Literal Blocks
listing_block.10000: LISTING_DELIM _NEWLINE LISTING_CONTENT _NEWLINE LISTING_DELIM _NEWLINE?
literal_block.10000: LITERAL_DELIM _NEWLINE LITERAL_CONTENT _NEWLINE LITERAL_DELIM _NEWLINE?

passthrough_block.10000: PASSTHROUGH_BLOCK_DELIM _NEWLINE PASSTHROUGH_CONTENT _NEWLINE PASSTHROUGH_BLOCK_DELIM

outer_listing_block.10000: OUTER_LISTING_START _NEWLINE OUTER_LISTING_CONTENT _NEWLINE OUTER_LISTING_END _NEWLINE?
outer_literal_block.10000: OUTER_LITERAL_START _NEWLINE OUTER_LITERAL_CONTENT _NEWLINE OUTER_LITERAL_END _NEWLINE?
outer_passthrough_block.10000: OUTER_PASSTHROUGH_START _NEWLINE OUTER_PASSTHROUGH_CONTENT _NEWLINE OUTER_PASSTHROUGH_END _NEWLINE?
outer_comment_block.10000: OUTER_COMMENT_START _NEWLINE OUTER_COMMENT_CONTENT _NEWLINE OUTER_COMMENT_END _NEWLINE?

// Basic content (no containers)
basic_block: attributed_simple_block | blank_line

// Delimited Blocks with Nesting Support
admonition: admonition_4 | admonition_5 | admonition_6
example_block: example_4 | example_5 | example_6
sidebar: sidebar_4 | sidebar_5 | sidebar_6
quote_block: quote_4 | quote_5 | quote_6

admonition_4.10: ADMONITION_START _NEWLINE ADMONITION_DELIM_4 _NEWLINE (sidebar | example_5 | example_6 | quote_block | admonition_5 | admonition_6 | basic_block)* ADMONITION_DELIM_4 _NEWLINE?
admonition_5.10: ADMONITION_START _NEWLINE ADMONITION_DELIM_5 _NEWLINE (sidebar | example_4 | example_6 | quote_block | admonition_4 | admonition_6 | basic_block)* ADMONITION_DELIM_5 _NEWLINE?
admonition_6.10: ADMONITION_START _NEWLINE ADMONITION_DELIM_6 _NEWLINE (sidebar | example_4 | example_5 | quote_block | admonition_4 | admonition_5 | basic_block)* ADMONITION_DELIM_6 _NEWLINE?

example_4.10: ADMONITION_DELIM_4 _NEWLINE (sidebar | example_5 | example_6 | quote_block | admonition_5 | admonition_6 | basic_block)* ADMONITION_DELIM_4 _NEWLINE?
example_5.10: ADMONITION_DELIM_5 _NEWLINE (sidebar | example_4 | example_6 | quote_block | admonition_4 | admonition_6 | basic_block)* ADMONITION_DELIM_5 _NEWLINE?
example_6.10: ADMONITION_DELIM_6 _NEWLINE (sidebar | example_4 | example_5 | quote_block | admonition_4 | admonition_5 | basic_block)* ADMONITION_DELIM_6 _NEWLINE?

sidebar_4.10: SIDEBAR_DELIM_4 _NEWLINE (example_block | admonition | quote_block | sidebar_5 | sidebar_6 | basic_block)* SIDEBAR_DELIM_4 _NEWLINE?
sidebar_5.10: SIDEBAR_DELIM_5 _NEWLINE (example_block | admonition | quote_block | sidebar_4 | sidebar_6 | basic_block)* SIDEBAR_DELIM_5 _NEWLINE?
sidebar_6.10: SIDEBAR_DELIM_6 _NEWLINE (example_block | admonition | quote_block | sidebar_4 | sidebar_5 | basic_block)* SIDEBAR_DELIM_6 _NEWLINE?

open_block: open_block_legacy | open_block_4 | open_block_5 | open_block_6 | open_block_long

open_block_legacy.50: OPEN_BLOCK_DELIM _NEWLINE (example_block | admonition | sidebar | quote_block | open_block_4 | open_block_5 | open_block_6 | open_block_long | basic_block)* OPEN_BLOCK_DELIM _NEWLINE?

open_block_4.10: OPEN_BLOCK_DELIM_4 _NEWLINE (example_block | admonition | sidebar | quote_block | open_block_legacy | open_block_5 | open_block_6 | open_block_long | basic_block)* OPEN_BLOCK_DELIM_4 _NEWLINE?
open_block_5.10: OPEN_BLOCK_DELIM_5 _NEWLINE (example_block | admonition | sidebar | quote_block | open_block_legacy | open_block_4 | open_block_6 | open_block_long | basic_block)* OPEN_BLOCK_DELIM_5 _NEWLINE?
open_block_6.10: OPEN_BLOCK_DELIM_6 _NEWLINE (example_block | admonition | sidebar | quote_block | open_block_legacy | open_block_4 | open_block_5 | open_block_long | basic_block)* OPEN_BLOCK_DELIM_6 _NEWLINE?
open_block_long.10: OPEN_BLOCK_DELIM_LONG _NEWLINE (example_block | admonition | sidebar | quote_block | open_block_legacy | open_block_4 | open_block_5 | open_block_6 | basic_block)* OPEN_BLOCK_DELIM_LONG _NEWLINE?

quote_4.10: QUOTE_DELIM_4 _NEWLINE (example_block | admonition | sidebar | quote_5 | quote_6 | basic_block)* QUOTE_DELIM_4 _NEWLINE?
quote_5.10: QUOTE_DELIM_5 _NEWLINE (example_block | admonition | sidebar | quote_4 | quote_6 | basic_block)* QUOTE_DELIM_5 _NEWLINE?
quote_6.10: QUOTE_DELIM_6 _NEWLINE (example_block | admonition | sidebar | quote_4 | quote_5 | basic_block)* QUOTE_DELIM_6 _NEWLINE?

thematic_break: THEMATIC_BREAK_MARKER _NEWLINE
page_break: "<<<" _NEWLINE

// --- Inline Elements ---
// Using a recursive definition. Requires the Earley parser.
text_content: inline_element+

attribute_reference.2: LBRACE ATTR_NAME RBRACE

?base_inline: attribute_reference | inline_attribute_list | double_quoted | single_quoted | inline_image | icon_inline | inline_indexterm_macro | inline_indexterm_flow_triple | inline_indexterm_flow_double | inline_anchor | inline_xref | inline_bibref | inline_link | inline_break | inline_kbd | inline_button | inline_menu | inline_callout | inline_stem | inline_asciimath | inline_latexmath | inline_pass_macro | inline_triple_plus | WHITESPACE | COLON | WORD | NUMBER | LBRACE | RBRACE | EQUALS | LSQB | BACKTICK | LT | GT | PLUS | LPAR | RPAR

?inline_element: unconstrained_bold | bold | unconstrained_italic | italic | unconstrained_monospace | monospace | marked | superscript | subscript | footnote | footnoteref | base_inline | RSQB | ASTERISK | UNDERSCORE | CIRCUMFLEX | TILDE | HASH

footnote_text_content: footnote_inline_element+
?footnote_inline_element: unconstrained_bold | bold | unconstrained_italic | italic | unconstrained_monospace | monospace | marked | superscript | subscript | footnote | footnoteref | base_inline | ASTERISK | UNDERSCORE | CIRCUMFLEX | TILDE | HASH

inline_break: INLINE_BREAK
inline_kbd.10: "kbd:[" ATTR_LIST_CONTENT "]"
inline_button.10: "btn:[" ATTR_LIST_CONTENT "]"
inline_menu.10: "menu:" WORD "[" [ATTR_LIST_CONTENT] "]"
inline_callout: "<" NUMBER ">"
inline_stem.10: "stem:[" [ATTR_LIST_CONTENT] "]"
inline_asciimath.10: "asciimath:[" [ATTR_LIST_CONTENT] "]"
inline_latexmath.10: "latexmath:[" [ATTR_LIST_CONTENT] "]"
inline_pass_macro.20: "pass:[" [PASS_MACRO_CONTENT] "]"
inline_triple_plus.20: "+++" [PASS_TRIPLE_CONTENT] "+++"

block_macro.50: WORD "::" MACRO_TARGET [LSQB] [ATTR_LIST_CONTENT] [RSQB] _NEWLINE
              | WORD "::" LSQB [ATTR_LIST_CONTENT] RSQB _NEWLINE

inline_image.10: "image:" TARGET inline_attribute_list
icon_inline.10: "icon:" TARGET inline_attribute_list

inline_anchor.10: "[[" text_content "]]" | "anchor:" TARGET inline_attribute_list
inline_xref.10: "<<" text_content ">>" | "xref:" TARGET inline_attribute_list
inline_bibref.12: "[[[" text_content "]]]"
inline_link.10: "link:" (TARGET | URI) inline_attribute_list | URI inline_attribute_list

URI.3: /(https?|ftp|file|irc):\/\/[^\[\n ]+/ | /mailto:[^\[\n ]+/
MACRO_TARGET: /[^:\[\n ][^\[\n ]*/
TARGET: /[^\[\n ]+/

footnote.10: "footnote:" "[" footnote_text_content "]"
footnoteref.10: "footnoteref:" "[" [FN_ID] ["," [WHITESPACE] footnote_text_content] "]"

inline_indexterm_macro.20: "indexterm:[" [ATTR_LIST_CONTENT] "]"
inline_indexterm_flow_triple.30: "(((" text_content ")))"
inline_indexterm_flow_double.20: "((" text_content "))"

// Text that allows substitutions but NOT formatting (for now, simplistic)
literal_content: /[^\n`]+/ 

bold.2: ASTERISK bold_content ASTERISK
unconstrained_bold.3: "**" bold_content "**"
italic.2: UNDERSCORE italic_content UNDERSCORE
unconstrained_italic.3: "__" italic_content "__"

monospace.10: "`" monospace_content "`"
unconstrained_monospace.10: "``" unconstrained_monospace_content "``"

monospace_content: (attribute_reference | MONOSPACE_TEXT)+
unconstrained_monospace_content: (attribute_reference | UNCONSTRAINED_MONOSPACE_TEXT)+

MONOSPACE_TEXT: /[^`{\n]+/ | "{"
UNCONSTRAINED_MONOSPACE_TEXT: /([^`{\n]|`[^`])+/ | "{"

marked.2: HASH marked_content HASH
superscript.2: CIRCUMFLEX superscript_content CIRCUMFLEX
subscript.2: TILDE subscript_content TILDE
double_quoted: "\"`" text_content "`\""
single_quoted: "'`" text_content "`'"

bold_content: bold_inline_element+
?bold_inline_element: unconstrained_italic | italic | unconstrained_monospace | monospace | marked | superscript | subscript | footnote | footnoteref | base_inline | RSQB | UNDERSCORE | CIRCUMFLEX | TILDE | HASH

italic_content: italic_inline_element+
?italic_inline_element: unconstrained_bold | bold | unconstrained_monospace | monospace | marked | superscript | subscript | footnote | footnoteref | base_inline | RSQB | ASTERISK | CIRCUMFLEX | TILDE | HASH

marked_content: marked_inline_element+
?marked_inline_element: unconstrained_bold | bold | unconstrained_italic | italic | unconstrained_monospace | monospace | superscript | subscript | footnote | footnoteref | base_inline | RSQB | ASTERISK | UNDERSCORE | CIRCUMFLEX | TILDE

superscript_content: superscript_inline_element+
?superscript_inline_element: unconstrained_bold | bold | unconstrained_italic | italic | unconstrained_monospace | monospace | marked | subscript | footnote | footnoteref | base_inline | RSQB | ASTERISK | UNDERSCORE | TILDE | HASH

subscript_content: subscript_inline_element+
?subscript_inline_element: unconstrained_bold | bold | unconstrained_italic | italic | unconstrained_monospace | monospace | marked | superscript | footnote | footnoteref | base_inline | RSQB | ASTERISK | UNDERSCORE | CIRCUMFLEX | HASH


// --- Terminals ---

// Block Terminals
DOC_TITLE_LEAD.3: "="
SECTION_TITLE_LEAD.2: /=+/
ULIST_MARKER: /[ \t]*(\*+|[-])[ \t]+/
OLIST_MARKER: /[ \t]*([0-9]+\.|[\.]+)[ \t]+/
DLIST_MARKER_5: /[ \t]*:::::(?!:)(?=[ \t\n]|$)/
DLIST_MARKER_4: /[ \t]*::::(?!:)(?=[ \t\n]|$)/
DLIST_MARKER_3: /[ \t]*:::(?!:)(?=[ \t\n]|$)/
DLIST_MARKER_2: /[ \t]*::(?!:)(?=[ \t\n]|$)/
LISTING_DELIM.2: /[ \t]*-{4,}/
LITERAL_DELIM.2: /[ \t]*\.{4,}/
PASSTHROUGH_BLOCK_DELIM.2: /[ \t]*\+{4,}/
ADMONITION_START.5: /[ \t]*\[ *(NOTE|TIP|IMPORTANT|WARNING|CAUTION) *\]/

ADMONITION_DELIM_4.2: "===="
ADMONITION_DELIM_5.2: "====="
ADMONITION_DELIM_6.2: "======"
ADMONITION_DELIM_LONG: /={7,}/

SIDEBAR_DELIM_4: "****"
SIDEBAR_DELIM_5: "*****"
SIDEBAR_DELIM_6: "******"
SIDEBAR_DELIM_LONG: /\*{7,}/

OPEN_BLOCK_DELIM.10: /(?<!-)-{2}(?!-)/
OPEN_BLOCK_DELIM_4.10: "~~~~"
OPEN_BLOCK_DELIM_5.10: "~~~~~"
OPEN_BLOCK_DELIM_6.10: "~~~~~~"
OPEN_BLOCK_DELIM_LONG.10: /~{7,}/

QUOTE_DELIM_4: "____"
QUOTE_DELIM_5: "_____"
QUOTE_DELIM_6: "______"
QUOTE_DELIM_LONG: /_{7,}/

THEMATIC_BREAK_MARKER.5: /'{3,}|\*{3}(?!\*)|\*{5,}|-{3}(?!-)|-{5,}|(_ _ _)+|(\* \* \*)+|(- - -)+/

// Non-greedy content matching for listing and literal blocks.
LISTING_CONTENT: /(.+?)(?=\n-{4,})/s
LITERAL_CONTENT: /(.+?)(?=\n\.{4,})/s
PASSTHROUGH_CONTENT: /(.+?)(?=\n\+{4,})/s

OUTER_LISTING_START.20: /--ASCIIDOCTRINE_OUTER_LISTING_START_[0-9]+--/
OUTER_LISTING_END.20: /--ASCIIDOCTRINE_OUTER_LISTING_END_[0-9]+--/
OUTER_LISTING_CONTENT.10: /(.+?)(?=\n--ASCIIDOCTRINE_OUTER_LISTING_END_[0-9]+--)/s

OUTER_LITERAL_START.20: /--ASCIIDOCTRINE_OUTER_LITERAL_START_[0-9]+--/
OUTER_LITERAL_END.20: /--ASCIIDOCTRINE_OUTER_LITERAL_END_[0-9]+--/
OUTER_LITERAL_CONTENT.10: /(.+?)(?=\n--ASCIIDOCTRINE_OUTER_LITERAL_END_[0-9]+--)/s

OUTER_PASSTHROUGH_START.20: /--ASCIIDOCTRINE_OUTER_PASSTHROUGH_START_[0-9]+--/
OUTER_PASSTHROUGH_END.20: /--ASCIIDOCTRINE_OUTER_PASSTHROUGH_END_[0-9]+--/
OUTER_PASSTHROUGH_CONTENT.10: /(.+?)(?=\n--ASCIIDOCTRINE_OUTER_PASSTHROUGH_END_[0-9]+--)/s

OUTER_COMMENT_START.20: /--ASCIIDOCTRINE_OUTER_COMMENT_START_[0-9]+--/
OUTER_COMMENT_END.20: /--ASCIIDOCTRINE_OUTER_COMMENT_END_[0-9]+--/
OUTER_COMMENT_CONTENT.10: /(.+?)(?=\n--ASCIIDOCTRINE_OUTER_COMMENT_END_[0-9]+--)/s

TABLE_CELL.20: /\|(.*?)(?=(?:(?<!\\)(?:[0-9.+\*]*[<>^.]*[adehlms]?)\|(?!===))|\|===)/s

PASS_MACRO_CONTENT: /[^\]]+/
PASS_TRIPLE_CONTENT: /.+?(?=\+\+\+)/s

_NEWLINE: "\n"
_WS: /[ \t]/
WHITESPACE: _WS+
NUMBER: /[0-9]+/
ATTR_NAME: /[a-zA-Z0-9_\-]+/
FN_ID: /[a-zA-Z0-9_\-]+/
WORD: /[^ \t\n*_`=\[\]{}:<>+()]+/  // Word characters (not whitespace or markup or parentheses)
LBRACE: "{"
RBRACE: "}"
LSQB: "["
RSQB: "]"
EQUALS: "="
BACKTICK: "`"
ASTERISK: "*"
UNDERSCORE: "_"
CIRCUMFLEX: "^"
TILDE: "~"
HASH: "#"
COLON: ":"
LT: "<"
GT: ">"
PLUS: "+"
INLINE_BREAK.15: " +"
LPAR: "("
RPAR: ")"

// %ignore WHITESPACE
