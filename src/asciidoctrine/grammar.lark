
start: document

document: document_header_with_body | body_only

document_header_with_body: (comment | blank_line)* document_header (blank_line block*)?
body_only: block*

document_header: document_title (attribute_entry | author_rev_line)*
author_rev_line: WORD (WORD | WHITESPACE | COLON | AUTHOR_SPECIAL_CHARS)* _NEWLINE
document_title: DOC_TITLE_LEAD WHITESPACE text_content _NEWLINE

AUTHOR_SPECIAL_CHARS: /[<>;,.@\-_]/

block: attributed_block | blank_line | attribute_entry | comment | block_macro | thematic_break | page_break

blank_line: _NEWLINE+

comment: "//" [COMMENT_CONTENT] _NEWLINE
COMMENT_CONTENT: /[^\n]+/

attributed_block: (block_metadata)* (section | ulist | olist | dlist | colist | table | listing_block | literal_block | passthrough_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | indented_literal | paragraph)

attributed_simple_block: (block_metadata)* (ulist | olist | dlist | colist | listing_block | literal_block | passthrough_block | shorthand_admonition | indented_literal | paragraph)

block_metadata: block_title | attribute_list | anchor
block_title: "." text_content _NEWLINE

// Sections and Titles
section: section_title
section_title: SECTION_TITLE_LEAD WHITESPACE text_content _NEWLINE

// Paragraphs
paragraph: (text_content _NEWLINE)+

indented_literal: INDENTED_LITERAL_LEAD text_content _NEWLINE
INDENTED_LITERAL_LEAD: /[ \t]+/

shorthand_admonition: ADMONITION_TYPE COLON [WHITESPACE] text_content _NEWLINE
ADMONITION_TYPE: "NOTE" | "TIP" | "IMPORTANT" | "WARNING" | "CAUTION"

// Lists
ulist: ulist_item+
olist: olist_item+
?dlist: dlist_5 | dlist_4 | dlist_3 | dlist_2
colist: colist_item+

ulist_item: ULIST_MARKER [CHECKBOX] text_content _NEWLINE
olist_item: OLIST_MARKER text_content _NEWLINE

colist_item: "<" NUMBER ">" [WHITESPACE] text_content _NEWLINE

?dlist_nested_2: dlist_5 | dlist_4 | dlist_3
?dlist_nested_3: dlist_5 | dlist_4 | dlist_2
?dlist_nested_4: dlist_5 | dlist_3 | dlist_2
?dlist_nested_5: dlist_4 | dlist_3 | dlist_2

dlist_2: dlist_item_2+ -> dlist
dlist_item_2: dlist_term_2+ dlist_description_2? -> dlist_item
dlist_term_2.12: text_content DLIST_MARKER_2 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_2.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_2 | colist | table | listing_block | literal_block | passthrough_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

dlist_3: dlist_item_3+ -> dlist
dlist_item_3: dlist_term_3+ dlist_description_3? -> dlist_item
dlist_term_3.12: text_content DLIST_MARKER_3 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_3.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_3 | colist | table | listing_block | literal_block | passthrough_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

dlist_4: dlist_item_4+ -> dlist
dlist_item_4: dlist_term_4+ dlist_description_4? -> dlist_item
dlist_term_4.12: text_content DLIST_MARKER_4 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_4.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_4 | colist | table | listing_block | literal_block | passthrough_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

dlist_5: dlist_item_5+ -> dlist
dlist_item_5: dlist_term_5+ dlist_description_5? -> dlist_item
dlist_term_5.12: text_content DLIST_MARKER_5 [WHITESPACE] _NEWLINE? -> dlist_term
dlist_description_5.15: _NEWLINE? [WHITESPACE] (section | ulist | olist | dlist_nested_5 | colist | table | listing_block | literal_block | passthrough_block | admonition | shorthand_admonition | sidebar | quote_block | open_block | example_block | paragraph)+ _NEWLINE? -> dlist_description

CHECKBOX: /\[[ x*X]\][ \t]+/

// Attributes
attribute_entry.2: COLON ATTR_NAME [BANG] COLON [WHITESPACE] [text_content] _NEWLINE
                 | COLON BANG ATTR_NAME COLON [WHITESPACE] _NEWLINE

BANG: "!"

// Attribute List (e.g., [source,python])
attribute_list.1: "[" [ATTR_LIST_CONTENT] "]" _NEWLINE
ATTR_LIST_CONTENT: /[^\]]+/

inline_attribute_list: "[" [ATTR_LIST_CONTENT] "]"

anchor.1: "[[" WORD "]]" _NEWLINE

// Tables
table: TABLE_DELIM _NEWLINE (table_cell | _NEWLINE)* TABLE_DELIM _NEWLINE?
table_cell: [table_cell_spec] TABLE_CELL

table_cell_spec: (span_spec | multiplier_spec)? (align_spec)? [STYLE_SPEC]

?span_spec: [NUMBER] "." NUMBER "+" -> span_both
          | NUMBER "+"             -> span_cols

?multiplier_spec: NUMBER "*" -> multiplier

?align_spec: HORIZ_ALIGN [VERT_ALIGN] -> align_both
           | VERT_ALIGN             -> align_vert

TABLE_DELIM: "|==="


HORIZ_ALIGN: "<" | ">" | "^"
VERT_ALIGN: "." ("<" | ">" | "^")
STYLE_SPEC: /[adehlms]/


// Listing and Literal Blocks
listing_block: LISTING_DELIM _NEWLINE LISTING_CONTENT _NEWLINE LISTING_DELIM _NEWLINE?
literal_block: LITERAL_DELIM _NEWLINE LITERAL_CONTENT _NEWLINE LITERAL_DELIM _NEWLINE?

passthrough_block: PASSTHROUGH_BLOCK_DELIM _NEWLINE PASSTHROUGH_CONTENT _NEWLINE PASSTHROUGH_BLOCK_DELIM

// Basic content (no containers)
basic_block: attributed_simple_block | blank_line

// Delimited Blocks with Nesting Support
admonition: admonition_4 | admonition_5 | admonition_6
example_block: example_4 | example_5 | example_6
sidebar: sidebar_4 | sidebar_5 | sidebar_6
quote_block: quote_4 | quote_5 | quote_6

admonition_4: ADMONITION_START _NEWLINE ADMONITION_DELIM_4 _NEWLINE (sidebar | example_5 | example_6 | quote_block | admonition_5 | admonition_6 | basic_block)* ADMONITION_DELIM_4 _NEWLINE?
admonition_5: ADMONITION_START _NEWLINE ADMONITION_DELIM_5 _NEWLINE (sidebar | example_4 | example_6 | quote_block | admonition_4 | admonition_6 | basic_block)* ADMONITION_DELIM_5 _NEWLINE?
admonition_6: ADMONITION_START _NEWLINE ADMONITION_DELIM_6 _NEWLINE (sidebar | example_4 | example_5 | quote_block | admonition_4 | admonition_5 | basic_block)* ADMONITION_DELIM_6 _NEWLINE?

example_4: ADMONITION_DELIM_4 _NEWLINE (sidebar | example_5 | example_6 | quote_block | admonition_5 | admonition_6 | basic_block)* ADMONITION_DELIM_4 _NEWLINE?
example_5: ADMONITION_DELIM_5 _NEWLINE (sidebar | example_4 | example_6 | quote_block | admonition_4 | admonition_6 | basic_block)* ADMONITION_DELIM_5 _NEWLINE?
example_6: ADMONITION_DELIM_6 _NEWLINE (sidebar | example_4 | example_5 | quote_block | admonition_4 | admonition_5 | basic_block)* ADMONITION_DELIM_6 _NEWLINE?

sidebar_4: SIDEBAR_DELIM_4 _NEWLINE (example_block | admonition | quote_block | sidebar_5 | sidebar_6 | basic_block)* SIDEBAR_DELIM_4 _NEWLINE?
sidebar_5: SIDEBAR_DELIM_5 _NEWLINE (example_block | admonition | quote_block | sidebar_4 | sidebar_6 | basic_block)* SIDEBAR_DELIM_5 _NEWLINE?
sidebar_6: SIDEBAR_DELIM_6 _NEWLINE (example_block | admonition | quote_block | sidebar_4 | sidebar_5 | basic_block)* SIDEBAR_DELIM_6 _NEWLINE?

open_block: OPEN_BLOCK_DELIM _NEWLINE (example_block | admonition | sidebar | quote_block | basic_block)* OPEN_BLOCK_DELIM _NEWLINE?

quote_4: QUOTE_DELIM_4 _NEWLINE (example_block | admonition | sidebar | quote_5 | quote_6 | basic_block)* QUOTE_DELIM_4 _NEWLINE?
quote_5: QUOTE_DELIM_5 _NEWLINE (example_block | admonition | sidebar | quote_4 | quote_6 | basic_block)* QUOTE_DELIM_5 _NEWLINE?
quote_6: QUOTE_DELIM_6 _NEWLINE (example_block | admonition | sidebar | quote_4 | quote_5 | basic_block)* QUOTE_DELIM_6 _NEWLINE?

thematic_break: THEMATIC_BREAK_MARKER _NEWLINE
page_break: "<<<" _NEWLINE

// --- Inline Elements ---
// Using a recursive definition. Requires the Earley parser.
text_content: inline_element+

attribute_reference.2: LBRACE ATTR_NAME RBRACE
?inline_element: unconstrained_bold | bold | unconstrained_italic | italic | unconstrained_monospace | monospace | attribute_reference | inline_attribute_list | marked | superscript | subscript | footnote | footnoteref | double_quoted | single_quoted | inline_image | icon_inline | inline_anchor | inline_xref | inline_bibref | inline_link | inline_break | inline_kbd | inline_button | inline_menu | inline_callout | inline_stem | inline_asciimath | inline_latexmath | WHITESPACE | COLON | WORD | NUMBER | LBRACE | RBRACE | EQUALS | LSQB | RSQB | BACKTICK

inline_break: " +"
inline_kbd: "kbd:[" ATTR_LIST_CONTENT "]"
inline_button: "btn:[" ATTR_LIST_CONTENT "]"
inline_menu: "menu:" WORD "[" [ATTR_LIST_CONTENT] "]"
inline_callout: "<" NUMBER ">"
inline_stem: "stem:[" [ATTR_LIST_CONTENT] "]"
inline_asciimath: "asciimath:[" [ATTR_LIST_CONTENT] "]"
inline_latexmath: "latexmath:[" [ATTR_LIST_CONTENT] "]"

block_macro.50: WORD "::" [TARGET] [LSQB] [ATTR_LIST_CONTENT] [RSQB] _NEWLINE

inline_image: "image:" TARGET inline_attribute_list
icon_inline: "icon:" TARGET inline_attribute_list

inline_anchor: "[[" text_content "]]" | "anchor:" TARGET inline_attribute_list
inline_xref: "<<" text_content ">>" | "xref:" TARGET inline_attribute_list
inline_bibref: "[[[" text_content "]]]"
inline_link: "link:" TARGET inline_attribute_list | URI inline_attribute_list

URI.3: /(https?|ftp|file|irc):\/\/[^\[\n ]+/ | /mailto:[^\[\n ]+/
TARGET: /[^\[\n ]+/

footnote: "footnote:" "[" text_content "]"
footnoteref: "footnoteref:" "[" [WORD] ["," text_content] "]"

// Text that allows substitutions but NOT formatting (for now, simplistic)
literal_content: /[^\n`]+/ 

bold: "*" text_content "*"
unconstrained_bold.2: "**" text_content "**"
italic: "_" text_content "_"
unconstrained_italic.2: "__" text_content "__"

monospace: "`" monospace_content "`"
unconstrained_monospace.2: "``" unconstrained_monospace_content "``"

monospace_content: (attribute_reference | MONOSPACE_TEXT)+
unconstrained_monospace_content: (attribute_reference | UNCONSTRAINED_MONOSPACE_TEXT)+

MONOSPACE_TEXT: /[^`{\n]+/ | "{"
UNCONSTRAINED_MONOSPACE_TEXT: /([^`{\n]|`[^`])+/ | "{"

marked: "#" text_content "#"
superscript: "^" text_content "^"
subscript: "~" text_content "~"
double_quoted: "\"`" text_content "`\""
single_quoted: "'`" text_content "`'"


// --- Terminals ---

// Block Terminals
DOC_TITLE_LEAD.3: "="
SECTION_TITLE_LEAD.2: /=+/
ULIST_MARKER: /[ \t]*(\*+|[-])[ \t]+/
OLIST_MARKER: /[ \t]*([0-9]+\.|[\.]+)[ \t]+/
DLIST_MARKER_5: /[ \t]*:::::(?!:)/
DLIST_MARKER_4: /[ \t]*::::(?!:)/
DLIST_MARKER_3: /[ \t]*:::(?!:)/
DLIST_MARKER_2: /[ \t]*::(?!:)/
LISTING_DELIM.2: /[ \t]*-{4,}/
LITERAL_DELIM.2: /[ \t]*\.{4,}/
PASSTHROUGH_BLOCK_DELIM.2: /[ \t]*\+{4,}/
ADMONITION_START.5: /[ \t]*\[ *(NOTE|TIP|IMPORTANT|WARNING|CAUTION) *\]/

ADMONITION_DELIM_4.2: "===="
ADMONITION_DELIM_5.2: "====="
ADMONITION_DELIM_6.2: "======"
ADMONITION_DELIM_LONG: /={7,}/

SIDEBAR_DELIM_4: "****"
SIDEBAR_DELIM_5: "*****"
SIDEBAR_DELIM_6: "******"
SIDEBAR_DELIM_LONG: /\*{7,}/

OPEN_BLOCK_DELIM: "--"

QUOTE_DELIM_4: "____"
QUOTE_DELIM_5: "_____"
QUOTE_DELIM_6: "______"
QUOTE_DELIM_LONG: /_{7,}/

THEMATIC_BREAK_MARKER: /'''+|\*\*\*+|---+|(_ _ _)+|(\* \* \*)+|(- - -)+/

// Non-greedy content matching for listing and literal blocks.
LISTING_CONTENT: /(.+?)(?=\n-{4,})/s
LITERAL_CONTENT: /(.+?)(?=\n\.{4,})/s
PASSTHROUGH_CONTENT: /(.+?)(?=\n\+{4,})/s
TABLE_CELL: /\|(.*?)(?=(?:(?<!\\)(?:(?:(?:[0-9]+)?(?:\.[0-9]+)?\+|[0-9]+\*)(?:[<>^]|\.[<>^]|[<>^]\.[<>^])?[adehlms]?|(?:[<>^]|\.[<>^]|[<>^]\.[<>^])[adehlms]?|[adehlms])?\|(?!===))|\|===)/s



_NEWLINE: /(\r\n|\n|\r)/
_WS: /[ \t]/
WHITESPACE: _WS+
NUMBER: /[0-9]+/
ATTR_NAME: /[a-zA-Z0-9_\-]+/
WORD: /[^ \t\n*_`=\[\]{}:]+/  // Word characters (not whitespace or markup)
LBRACE: "{"
RBRACE: "}"
LSQB: "["
RSQB: "]"
EQUALS: "="
BACKTICK: "`"
COLON: /:(?!:)/

// %ignore WHITESPACE
